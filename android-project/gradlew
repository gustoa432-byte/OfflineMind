#!/usr/bin/env sh
##############################################################################
##
##  Gradle start up script for UN*X
##
##############################################################################

# Attempt to locate gradle from wrapper or system
GRADLE_BIN="/root/.gradle/wrapper/dists/gradle-8.14.3-bin/cv11ve7ro1n3o1j4so8xd9n66/gradle-8.14.3/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
    GRADLE_BIN=$(command -v gradle 2>/dev/null)
fi

if [ -z "$GRADLE_BIN" ]; then
    echo "ERROR: Gradle not found. Please install Gradle 8.x or set GRADLE_HOME." >&2
    exit 1
fi

exec "$GRADLE_BIN" "$@"
